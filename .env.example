# Copy this file to .env before starting the stack:
#   cp .env.example .env
#
# .env is gitignored and must never be committed.
# Keep comments on their own line: docker compose does not reliably strip a
# trailing comment from a value in an env_file.

# ---------- Application ----------
APP_NAME=AI Interview Platform

# development | staging | production
APP_ENV=development

DEBUG=true

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ---------- Security (required) ----------
# Minimum 32 characters. The value below is for local development only.
# Generate a real one for anything else:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-secret-change-me-before-deploying-anywhere

# How long an access token stays valid. There is no refresh token and no
# revocation list, so this is the only limit on a leaked token.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------- Database (required) ----------
# The host "postgres" is the docker compose service name.
DATABASE_URL=postgresql+asyncpg://interview:interview@postgres:5432/interview

# ---------- Redis (required) ----------
# The host "redis" is the docker compose service name.
REDIS_URL=redis://redis:6379/0

# ---------- AI provider ----------
# fake | gemini
AI_PROVIDER=fake

# Only needed when AI_PROVIDER=gemini.
GEMINI_API_KEY=
